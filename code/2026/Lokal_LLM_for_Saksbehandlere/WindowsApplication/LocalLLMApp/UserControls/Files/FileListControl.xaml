<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LocalLLMApp.UserControls.Files.FileListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UIconverters="using:LocalLLMApp.Converters.UI"
    xmlns:models="using:LocalLLMApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- FileListControl is a reusable component for displaying a list of file attachments
         - Displays file names with icons based on file type
         - Individual file removal via delete button
    
         Used in:
         - CasePage.xaml: Shows files and attachments in the context panel (right side)
    -->
    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
        
        <!-- OPTION: Change SelectionMode to Multiple to enable multi-file selection -->
        <ListView x:Name="FileListView"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  Background="Transparent"
                  ItemClick="FileItem_Clicked"
                  ItemsSource="{x:Bind Items, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FilesInfo">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- File icon (dynamically changed based on file type) -->
                        <FontIcon Grid.Column="0" 
                                  Glyph="{x:Bind FileExtension, Converter={StaticResource FileExtensionToGlyphConverter}, Mode=OneWay}"                                  
                                  FontSize="16"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>

                        <!-- File name -->
                        <TextBlock Grid.Column="1" 
                                   Text="{x:Bind FileName, Mode=OneWay}" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Delete button (for single item) -->
                        <Button Grid.Column="2" 
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                Click="RemoveButton_Click"
                                ToolTipService.ToolTip="Fjern fil">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <!-- OPTIONAL: Multi-file selection and deletion - "Edit" button functionality -->

        </ListView>
    </ScrollViewer>
</UserControl>
