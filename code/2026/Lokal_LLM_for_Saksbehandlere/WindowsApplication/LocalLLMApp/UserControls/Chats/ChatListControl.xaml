<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LocalLLMApp.UserControls.Chats.ChatListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalLLMApp.UserControls.Chats"
    xmlns:models="using:LocalLLMApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:UIconverters="using:LocalLLMApp.Converters.UI"

    mc:Ignorable="d">

    <!-- ChatListControl
    - Reusable control for displaying a list of chats, binds to the Chat model
    - Defines datatemplate for an instance of a chat item in the list
    - Defines a bordered scrollviewer to hold defined chat items   
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <DataTemplate x:Key="ChatListViewTemplate" x:DataType="models:Chat">
                <Grid Background="Transparent" Margin="0,10,0,12">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                    <!-- Chat info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock Text="{x:Bind CreatedAt, Converter={StaticResource DateTimeDisplayConverter}, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <!--<Border Height="1" Width="8"
                                    Background="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    Opacity="0.6"/>-->


                            <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>


                    <!-- "More options" button -->
                <Button Grid.Column="1"
                            AutomationProperties.Name="More options" 
                            Background="Transparent" 
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right">
                    <SymbolIcon Symbol="More"/>
                    <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Gi nytt navn" Click="RenameChatMenuFlyoutItem_Click">
                                    <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator/>

                            <MenuFlyoutItem Text="Slett samtale" Foreground="Red" Click="DeleteChatMenuFlyoutItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" Foreground="Red"/>
                                </MenuFlyoutItem.Icon>

                                    <!--<MenuFlyoutItem Text="Flytt til annen sak">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>-->
                                    <!--<MenuFlyoutItem Text="Fjern fra sak">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECC9;"/>
                                </MenuFlyoutItem.Icon>-->
                                    <!--</MenuFlyoutItem>-->
                                </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

     </ResourceDictionary>
     </UserControl.Resources>
    
    <!--Gray background containing previous case chats-->
    <Border Grid.Row="1"
            BorderBrush="{ThemeResource TextControlBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8"
            Background="{ThemeResource TextControlBackground}"
            MinWidth="320"
            HorizontalAlignment="Stretch"
            Padding="4">

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!--Code template for case chat-->
                <ListView HorizontalAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="ChatListView_ItemClick"
                      ItemsSource="{x:Bind Items, Mode=OneWay}"
                      ItemTemplate="{StaticResource ChatListViewTemplate}">
                </ListView>
            </ScrollViewer>

            <TextBlock Text="Ingen samtaler"
                   Visibility="{x:Bind IsEmpty, Mode=OneWay}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="12,12,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource BodyTextBlockStyle}"/>
        </Grid>
    </Border>
</UserControl>
