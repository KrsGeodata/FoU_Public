<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LocalLLMApp.UserControls.Chats.ChatInputControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalLLMApp.UserControls.Chats"
    xmlns:fileControls="using:LocalLLMApp.UserControls.Files"
    xmlns:models="using:LocalLLMApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- ChatInputControl
    - Reusable control for user chat input box
    - AttachmentPillsPanel sits inside the Border, above the TextBox
    - Consists of: pills (when files attached), textbox, attach button, send button
-->

    <Border BorderBrush="{ThemeResource TextControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource TextControlBackground}"
            MinWidth="320"
            Padding="4,2,4,4"
            HorizontalAlignment="Stretch">

        <StackPanel Spacing="4" HorizontalAlignment="Stretch">

            <!-- Attachment pills: visible inside the input box when files are attached -->
            <fileControls:AttachmentPillsPanel
                x:Name="AttachmentPills"
                IsReadOnly="False"
                Attachments="{Binding Attachments, ElementName=Root}"
                AttachmentRemoved="AttachmentPills_RemoveRequested"/>
            <!-- TODO: 
            ClearAllRequested="AttachmentPills_ClearAllRequested"-->
            <!--OpenRequested="AttachmentPills_OpenRequested"/>-->

            <!-- Text input -->
            <TextBox Text="{x:Bind MessageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                     VerticalContentAlignment="Top"
                     HorizontalContentAlignment="Left"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     Padding="12"
                     MinHeight="48"
                     MaxHeight="80"
                     HorizontalAlignment="Stretch"
                     PreviewKeyDown="SendOnEnter"/>

            <!-- Buttons row -->
            <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Attach button -->
                <DropDownButton Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="4,0,4,4"
                                ToolTipService.ToolTip="Legg ved filer"
                                AutomationProperties.Name="Attach options">
                    <DropDownButton.Content>
                        <SymbolIcon Symbol="Attach" HorizontalAlignment="Center"/>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Legg til filer" Click="AddFilesMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Attach"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Send button -->
                <Button Command="{x:Bind SendCommand}"
                        Click="SendButton_Click"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Width="36"
                        Height="36"
                        CornerRadius="4"
                        Margin="4,0,4,4"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Send melding">
                    <FontIcon Glyph="&#xE74A;"
                              FontWeight="Normal"
                              FontSize="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
