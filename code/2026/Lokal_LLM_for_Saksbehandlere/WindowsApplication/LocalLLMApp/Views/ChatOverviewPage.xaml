<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LocalLLMApp.Views.ChatOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalLLMApp.Views"
    xmlns:models="using:LocalLLMApp.Models"
    xmlns:chatsUserControls="using:LocalLLMApp.UserControls.Chats"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UserControls/ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="36,40,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />      <!-- Title and primary action row -->
            <RowDefinition Height="Auto" />      <!-- Filter and sort, new chat actions -->
            <RowDefinition Height="*"    />      <!-- Chat list -->
        </Grid.RowDefinitions>


            <TextBlock Grid.Column="0"
                       Text="Alle samtaler"
                       Style="{StaticResource TitleLargeTextBlockStyle}" />


        <!-- Row 1: Filter, sort and new chat actions -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Stretch"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- Filter -->
                <ColumnDefinition Width="Auto" />   <!-- Sort -->
                <ColumnDefinition Width="*" />      <!-- Space -->
                <ColumnDefinition Width="Auto" />   <!-- Ny samtale -->
            </Grid.ColumnDefinitions>

            <!-- Filter button with label and RadioButton flyout -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <SplitButton Content="{x:Bind ViewModel.ActiveFilter, Mode=OneWay}"
                             ToolTipService.ToolTip="Filtrer samtaler etter sak-status"> 
                    <SplitButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filtrer"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <RadioButton Content="Vis alle samtaler"
                                             Tag="All"
                                             GroupName="ChatFilter"
                                             IsChecked="True"
                                             Checked="FilterRadioButton_Checked" />
                                <RadioButton Content="Vis samtaler knyttet til sak"
                                             Tag="LinkedToCase"
                                             GroupName="ChatFilter"
                                             Checked="FilterRadioButton_Checked" />
                                <RadioButton Content="Vis samtaler uten sak"
                                             Tag="ChatsWithoutCase"
                                             GroupName="ChatFilter"
                                             Checked="FilterRadioButton_Checked" />
                            </StackPanel>
                        </Flyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>

            <!-- Sort Button -->
            <DropDownButton Grid.Column="1" 
                ToolTipService.ToolTip="Sorter samtaler etter dato">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" />
                    <TextBlock Text="Sortering: " />
                    <TextBlock Text="{x:Bind ViewModel.ActiveSort, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sorter etter dato"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <RadioButton Content="Nyeste først"
                                         GroupName="SortGroup"
                                         IsChecked="True"
                                         Checked="SortDescending_Click" />
                            <RadioButton Content="Eldste først"
                                         GroupName="SortGroup"
                                         Checked="SortAscending_Click" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Ny samtale -->
            <Button Grid.Column="3"
            Style="{StaticResource AccentButtonStyle}"
            Click="NewChatButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xECC8;" />
                    <TextBlock Text="Ny samtale" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 2: Chat list -->
        <chatsUserControls:ChatListControl Grid.Row="2"
                                  Items="{x:Bind ViewModel.FilteredChats, Mode=OneWay}"
                                  IsEmpty="{x:Bind ViewModel.IsChatsEmpty, Mode=OneWay}"
                                  ChatItemClicked="ChatListControl_ChatItemClicked" 
                                  DeleteChatRequested="ChatListControl_DeleteChatRequested"
                                  RenameChatRequested="ChatListControl_RenameChatRequested"/>
    </Grid>
</Page>