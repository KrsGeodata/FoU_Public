<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LocalLLMApp.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalLLMApp.Models"
    xmlns:viewModels="using:LocalLLMApp.ViewModels"
    xmlns:chatsUserControls="using:LocalLLMApp.UserControls.Chats"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="ChatPage_Loaded">

    <!-- Single column Grid -->
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>            <!-- Title + Edit Button -->
            <RowDefinition Height="Auto"/>            <!-- Description -->
            <RowDefinition Height="*"/>               <!-- Messages -->
            <RowDefinition Height="Auto"/>            <!-- Loading indicator -->
            <RowDefinition Height="Auto"/>            <!-- Input -->
        </Grid.RowDefinitions>

        <!-- Row 0: Title + Edit Button -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    Spacing="8" 
                    VerticalAlignment="Center"
                    Margin="0,0,0,4">
            <TextBlock x:Name="ChatTitleTextBlock"
                       Text="{x:Bind ViewModel.CurrentChatTitle, Mode=OneWay}"
                       Style="{StaticResource TitleLargeTextBlockStyle}"/>

            <Button x:Name="EditTitleButton"
                    Click="EditTitleButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Endre saks-tittel">
                <FontIcon Glyph="&#xE70F;" FontSize="16"/>
            </Button>
        </StackPanel>

        <!-- Row 1: Description -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.CurrentChatDescription, Mode=OneWay}"
                   Style="{StaticResource SubtitleTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16"/>

        <!-- Row 2: Messages ScrollView -->
        <ScrollView x:Name="MessageScrollViewer" Grid.Row="2">
            <ItemsControl x:Name="MessageItemsControl"
                          ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                          SizeChanged="MessageItemsControl_SizeChanged">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <chatsUserControls:ChatMessageControl
                            MessageText="{x:Bind MessageText, Mode=OneWay}"
                            Alignment="{x:Bind Alignment, Mode=OneWay}"
                            Attachments="{x:Bind Attachments, Mode=OneWay}"
                            CreatedAt="{x:Bind CreatedAt,Mode=OneWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollView>

        <!-- Row 3: Loading Indicator -->
        <ProgressRing Grid.Row="3"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Left"
                      Margin="0,4,0,4"/>

        <!-- Row 4: Input Area -->
        <chatsUserControls:ChatInputControl Grid.Row="4" 
                                   MessageInput="{x:Bind ViewModel.MessageInput, Mode=TwoWay}"
                                   SendCommand="{x:Bind ViewModel.SendMessageCommand}"
                                   Attachments="{x:Bind ViewModel.PendingAttachments, Mode=OneWay}"
                                   AddFilesRequested="ChatInputControl_AddFilesRequested"
                                   AttachmentRemoved="ChatInputControl_AttachmentRemoved"/>
    </Grid>
</Page>