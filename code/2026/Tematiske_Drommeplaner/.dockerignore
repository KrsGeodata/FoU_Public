# Git and version control
.git/
.gitignore

# Dependencies
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Build outputs (keep source for Docker builds)
**/dist/
**/build/
**/.next/

# Development files
**/.env.local
**/.env.development.local
**/.env.test.local
*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation
**/README.md
**/docs/

# Docker files (avoid recursion)
Dockerfile*
docker-compose*

# Logs
**/logs/
**/*.log

# Temporary files
**/tmp/
**/temp/
