# Root-level environment flags that apply across multiple services.
# Per-service secrets live in ./<service>/<service>.env (see README.md).

# DEMO_MODE
# -----------------------------------------------------------------------------
# When set to `true`, backend/arkiv-service/cms-service/matrikkel-service/
# renovasjon-service/wagtail-cms each register a coloured per-request logging
# middleware (e.g. "🟦 BACKEND  ← GET /eiendommer/sok → 200 (45ms)") that was
# built for the Pi2 presentation demo. When `false`, the middleware is not
# registered, so no demo lines are emitted.
#
# Defaults:
#   docker-compose.yml       — DEMO_MODE=true   (dev/demo stack)
#   docker-compose.prod.yml  — DEMO_MODE=false  (production)
#
# Related: see issue #547 for rationale and issue #546 for the PII contract
# that defines what WOULD still be logged at INFO even with demo mode on.
DEMO_MODE=false
