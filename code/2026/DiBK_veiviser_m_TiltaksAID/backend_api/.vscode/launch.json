    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI Debugger mode",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}